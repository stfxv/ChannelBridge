<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
<title>ChannelBridge 仮想マイク</title>
<options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
<domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
<choices-outline><line choice="driver"/></choices-outline>
<choice id="driver" visible="false"><pkg-ref id="local.channelbridge.driver.pkg"/></choice>
<pkg-ref id="local.channelbridge.driver.pkg" version="0.1.0" onConclusion="RequireRestart">driver-component.pkg</pkg-ref>
</installer-gui-script>
